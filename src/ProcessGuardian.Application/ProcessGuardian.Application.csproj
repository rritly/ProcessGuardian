<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ProcessGuardian.Domain\ProcessGuardian.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only BackgroundService/DI abstractions are used; the full Hosting package
         drags in configuration/DI infrastructure the Application layer does not need. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test seams (launch-gate hooks) and internal helpers are exercised by the
         Application unit-test assembly without weakening encapsulation publicly. -->
    <InternalsVisibleTo Include="ProcessGuardian.Application.Tests" />
  </ItemGroup>
</Project>

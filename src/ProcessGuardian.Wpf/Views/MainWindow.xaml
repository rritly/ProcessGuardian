        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource WhiteBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,0,0,6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="8,0"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource WhiteBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <!-- 3 chars = max 999; I-beam over the whole box, not just the digits. -->
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#0064DF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0072D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00478C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FontSize" Value="16.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#0064DF"
                                BorderThickness="1"
                                CornerRadius="0,6,6,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform Y="-1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0072D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00478C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box"
                                Width="18" Height="18"
                                Background="{StaticResource InputBgBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Path x:Name="check"
                                  Width="10" Height="8"
                                  Data="M 0,5 L 4,9 L 13,0"
                                  Stroke="{StaticResource WhiteBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#0064DF" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="bd" Background="{StaticResource ScrollThumbBrush}">
                                            <Path Data="M 5,12 L 10,6 L 15,12 Z"
                                                  Fill="{StaticResource WhiteBrush}"
                                                  Stretch="Uniform"
                                                  Margin="3,3,3,4" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#667588" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#667588" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1,0">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="ThumbPart">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{StaticResource ScrollThumbBrush}"
                                                            CornerRadius="0" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#667588" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#667588" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                            <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border x:Name="bd" Background="{StaticResource ScrollThumbBrush}">
                                            <Path Data="M 5,6 L 10,12 L 15,6 Z"
                                                  Fill="{StaticResource WhiteBrush}"
                                                  Stretch="Uniform"
                                                  Margin="3,4,3,3" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#667588" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#667588" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="17" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="True" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="2"
                                       Width="16"
                                       HorizontalAlignment="Left"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                        ViewportSize="{TemplateBinding ViewportHeight}"
                                        Minimum="0"
                                        Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                        IsEnabled="{TemplateBinding IsEnabled}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Minimum="0"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       IsEnabled="{TemplateBinding IsEnabled}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D3D4F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Monitoring">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Restarting">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Monitoring">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Restarting">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StoppedTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Monitoring">
                    <Setter Property="Foreground" Value="{StaticResource MonitoringTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Foreground" Value="{StaticResource MonitoringTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Restarting">
                    <Setter Property="Foreground" Value="{StaticResource MonitoringTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource StoppedTextBrush}" />
            <Setter Property="Background" Value="{StaticResource StoppedFillBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Monitoring">
                    <Setter Property="BorderBrush" Value="{StaticResource MonitoringTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource MonitoringFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="BorderBrush" Value="{StaticResource MonitoringTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource MonitoringFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Restarting">
                    <Setter Property="BorderBrush" Value="{StaticResource MonitoringTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource MonitoringFillBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource ErrorFillBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="DesignRoot" Width="573" Height="532"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Margin="0"
          UseLayoutRounding="True"
          TextOptions.TextRenderingMode="Grayscale"
          TextOptions.TextHintingMode="Fixed">
        <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== CARD 1: SETTINGS ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="False">
            <Grid Margin="15,15,15,15" ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="23" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <!-- Target row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Target"
                               FontSize="12"
                               Foreground="{StaticResource LabelBrush}"
                               Width="47"
                               VerticalAlignment="Center" />
                    <TextBox Width="433" Height="30"
                             Style="{StaticResource DarkTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             Text="{Binding Settings.TargetProcessPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Width="30" Height="30"
                            Style="{StaticResource AddButtonStyle}"
                            Content="+"
                            Command="{Binding BrowseExecutableCommand}" />
                </StackPanel>

                <!-- Numeric row 1 -->
                <Grid Grid.Row="2" Margin="-16,0,0,0" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="33" />
                        <ColumnDefinition Width="138" />
                        <ColumnDefinition Width="33" />
                        <ColumnDefinition Width="163" />
                        <ColumnDefinition Width="33" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Check interval (s)"
                               Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource LabelBrush}" />
                    <TextBox Grid.Column="1" Width="33" Height="19"
                             Style="{StaticResource MiniBoxStyle}"
                             VerticalAlignment="Center"
                             Text="{Binding Settings.CheckIntervalSeconds, Mode=TwoWay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Verify timeout (s)"
                               Margin="27,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource LabelBrush}" />
                    <TextBox Grid.Column="3" Width="33" Height="19"
                             Style="{StaticResource MiniBoxStyle}"
                             VerticalAlignment="Center"
                             Text="{Binding Settings.StartupVerificationTimeoutSeconds, Mode=TwoWay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Max restart attempts"
                               Margin="26,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource LabelBrush}" />
                    <TextBox Grid.Column="5" Width="33" Height="19" Margin="-3,0,0,0"
                             Style="{StaticResource MiniBoxStyle}"
                             VerticalAlignment="Center"
                             Text="{Binding Settings.MaxRestartAttempts, Mode=TwoWay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Numeric row 2 -->
                <Grid Grid.Row="4" Margin="-15,0,0,0" ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="127" />
                        <ColumnDefinition Width="33" />
                        <ColumnDefinition Width="138" />
                        <ColumnDefinition Width="33" />
                        <ColumnDefinition Width="164" />
                        <ColumnDefinition Width="33" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Initial delay (s)"
                               Margin="16,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource LabelBrush}" />
                    <TextBox Grid.Column="1" Width="33" Height="19"
                             Style="{StaticResource MiniBoxStyle}"
                             VerticalAlignment="Center"
                             Text="{Binding Settings.InitialDelaySeconds, Mode=TwoWay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Restart delay (s)"
                               Margin="27,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource LabelBrush}" />
                    <TextBox Grid.Column="3" Width="33" Height="19"
                             Style="{StaticResource MiniBoxStyle}"
                             VerticalAlignment="Center"
                             Text="{Binding Settings.RestartDelaySeconds, Mode=TwoWay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Autostart with Windows"
                               Margin="26,-1,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource LabelBrush}" />
                    <CheckBox Grid.Column="5"
                              Width="18" Height="18"
                              Margin="9,0,0,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              IsEnabled="{Binding IsAutostartEditable}"
                              IsChecked="{Binding AutostartEffective, Mode=TwoWay}"
                              ToolTip="The checkbox reflects the verified autostart registration; it is locked while a recovery notice is pending." />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== CARD 2: MONITORING ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Fixed 60 DIP control row: the monitoring controls keep their intended
                         geometry and are vertically centered (the controls StackPanel uses
                         VerticalAlignment=Center). The message row below stays Auto so long
                         refusal/reset guidance wraps and grows the card without ever clipping. -->
                    <RowDefinition Height="60" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                <Grid Width="151" Height="30" Margin="15,0,0,0">
                    <Button Content="Start monitoring"
                            Style="{StaticResource StartButtonStyle}"
                            Command="{Binding StartCommand}" />
                    <Button Content="Disable"
                            Style="{StaticResource StopButtonStyle}"
                            Command="{Binding StopCommand}" />
                </Grid>

                <TextBlock Text="toast-notifications"
                           Margin="35,0,0,0"
                           Width="113"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource LabelBrush}" />

                <CheckBox Width="18" Height="18"
                          Margin="1,0,0,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          IsChecked="{Binding Settings.EnableToasts, Mode=TwoWay}" />

                <TextBlock Text="status"
                           Margin="35,0,0,0"
                           Width="46"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource LabelBrush}" />

                <Border Width="111" Height="30"
                        Margin="1,0,0,0"
                        CornerRadius="5"
                        Style="{StaticResource StatusBorderStyle}">
                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToDisplayConverter}}"
                               Style="{StaticResource StatusTextStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="DEGRADED"
                           Margin="8,0,0,0"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#E5554F"
                           VerticalAlignment="Center"
                           ToolTip="Monitoring is degraded; see the logs for details."
                           Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- Full-width guidance row below the monitoring controls/status row (R-A): long
                     refusal/reset guidance wraps and stays readable at normal window width instead of
                     being squeezed into the horizontal controls row or a fixed-height row. Each panel
                     collapses when its message is empty. -->
                <StackPanel Grid.Row="1" Margin="15,10,15,12" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding ConfigurationError}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               FontSize="11"
                               Foreground="#E5554F"
                               Visibility="{Binding ConfigurationError, Converter={StaticResource StringIsEmptyToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ResetNotice}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               FontSize="11"
                               Foreground="#E8A33D"
                               Visibility="{Binding ResetNotice, Converter={StaticResource StringIsEmptyToVisibilityConverter}}" />

                    <!-- Explicit recovery resolution (A/B). Only shown while a reset notice is
                         pending (which only the elevated edition produces), so the regular edition
                         never surfaces these actions. Option A is additionally gated by a recorded
                         pin through the command's CanExecute. The guidance directly explains what each
                         option does, so the re-pin requirement of option A is not a hidden step. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Visibility="{Binding ResetNotice, Converter={StaticResource StringIsEmptyToVisibilityConverter}}">
                        <Button Content="Keep autostart and finish recovery"
                                Command="{Binding KeepAutostartCommand}"
                                Padding="10,4"
                                FontSize="11"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Remove autostart and finish recovery"
                                Command="{Binding RemoveAutostartCommand}"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                FontSize="11"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>

                    <!-- What each recovery option does, so the user can decide without guessing.
                         Option A needs a freshly recorded pin (set by starting monitoring once). -->
                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               FontSize="11"
                               Foreground="{StaticResource LabelBrush}"
                               Visibility="{Binding ResetNotice, Converter={StaticResource StringIsEmptyToVisibilityConverter}}">
                        <Run Text="Keep autostart" FontWeight="Bold" /> — restores the automatic start of the
                        admin edition at Windows logon and finishes recovery. It requires re-selecting and
                        re-pinning the target first (start monitoring once, then return here).
                        <LineBreak />
                        <Run Text="Remove autostart" FontWeight="Bold" /> — deletes the scheduled task; the app
                        will not start automatically at the next logon. Monitoring is left as it is.</TextBlock>

                    <TextBlock Text="{Binding AutostartError}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               FontSize="11"
                               Foreground="#E5554F"
                               Visibility="{Binding AutostartError, Converter={StaticResource StringIsEmptyToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CARD 3: LOG ===== -->
        <Border Grid.Row="4"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="33" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Log"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13.5"
                               Foreground="{StaticResource LabelBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ClearLogsCommand}"
                                ToolTip="Clear Logs">
                            <Viewbox Width="14"
                                   Height="14"
                                   Stretch="Uniform">
                                <Path Data="{StaticResource TrashIconGeometry}"
                                   Fill="#C3D1DE" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding OpenLogsCommand}"
                                ToolTip="Open Logs">
                            <Viewbox Width="14"
                                   Height="14"
                                   Stretch="Uniform">
                                <Path Data="{StaticResource OpenBookIconGeometry}"
                                   Fill="#C3D1DE" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Separator -->
                <Border Grid.Row="1" Background="{StaticResource CardBorderBrush}" />

                <!-- Log content -->
                <ScrollViewer x:Name="LogViewer"
                              Grid.Row="2"
                              Margin="15"
                              Style="{StaticResource DarkScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              SnapsToDevicePixels="True">
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontSize="10.5"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource LabelBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             AcceptsReturn="True" />
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>

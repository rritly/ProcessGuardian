<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProcessGuardian</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Admin edition: separate exe name + requireAdministrator manifest.
       Regular Debug/Release builds keep the default (asInvoker) manifest. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release-Elevated'">
    <AssemblyName>ProcessGuardianAdmin</AssemblyName>
    <ApplicationManifest>app.admin.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProcessGuardian.Application\ProcessGuardian.Application.csproj" />
    <ProjectReference Include="..\ProcessGuardian.Infrastructure\ProcessGuardian.Infrastructure.csproj" />
    <ProjectReference Include="..\ProcessGuardian.Domain\ProcessGuardian.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>
</Project>

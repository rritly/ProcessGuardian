<UserControl x:Class="ProcessGuardian.Wpf.Notifications.ToastCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonDown="OnClick">

    <UserControl.Resources>
        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="RootBorder"
                             From="0" To="1" Duration="0:0:0.20"/>
        </Storyboard>

        <Storyboard x:Key="ExitStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" Storyboard.TargetName="RootBorder"
                             From="1" To="0" Duration="0:0:0.25"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="#1A252F"
            BorderBrush="#3E4854"
            BorderThickness="1"
            Opacity="0"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon slot -->
            <Border x:Name="IconContainer"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center">
                <Image x:Name="IconImage"
                       Width="40"
                       Height="40"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Text -->
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="Noto Sans, Segoe UI"
                       FontWeight="Black"
                       TextOptions.TextRenderingMode="Grayscale"
                       TextOptions.TextHintingMode="Fixed"/>
        </Grid>
    </Border>
</UserControl>
